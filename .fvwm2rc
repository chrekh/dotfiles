DeskTopSize 1x4
Test (EnvMatch HOST vdx*) DeskTopSize 1x2
Test (EnvMatch HOST bean) DeskTopSize 2x3
EdgeScroll 100 100
EdgeThickness 1
Test (EnvMatch HOST vdx*) EdgeResistance 200 0

ClickTime 750
ColormapFocus FollowsFocus
OpaqueMoveSize 100
Test (EnvMatch HOST lx*) OpaqueMoveSize 0
Test (EnvMatch HOST v1*) OpaqueMoveSize 0

IgnoreModifiers L2

Style "*" Font -adobe-times-medium-r-normal--18-180-75-75-p-94-iso8859-1/UTF-8
MenuStyle * Font -adobe-times-medium-r-normal--18-180-75-75-p-94-iso8859-1/UTF-8

Style "*" ResizeOpaque, HilightFore yellow, HilightBack #853f5a
Test (EnvMatch HOST lx*) Style "*" !ResizeOpaque, HilightFore yellow, HilightBack #853f5a
Test (EnvMatch HOST v1*) Style "*" !ResizeOpaque, HilightFore yellow, HilightBack #853f5a
Style * SloppyFocus, BorderWidth 5, !Handles , !Icon, Color black/#e08020
Style * UsePPosition

Style "FvwmWinList" !Title, Sticky, WindowListSkip, NeverFocus
Style "FvwmIconMan" !Title, Sticky, WindowListSkip, NeverFocus
Style "FvwmPager"   !Title, Sticky, NeverFocus
Style "XDaliClock"  !Title, Sticky, NeverFocus
Style "XClock"      !Title, Sticky, NeverFocus
Style "dclock"      !Title, Sticky
Style "launchwindow" !Title, Sticky
Style "XLoad"	    !Title, NeverFocus
#Style "rdesktop"    !Title, !Borders
Style "Tint2"	    !Title, !Borders
Style "Chrom*"      !Title
Style "Google-chrome*" !Title
Style "xcpustate"   !Title, Sticky, NeverFocus
Style "XBiff"       !Title, Sticky, NeverFocus
Style "XBuffy"      !Title, Sticky, NeverFocus
Style "wmpower"	    !Title, Sticky, WindowListSkip, NeverFocus, StaysOnTop
Style "wmbattery"   !Title, WindowListSkip, NeverFocus, StaysOnTop
Style "aumix"	    Sticky

# What to do at startup
AddToFunc InitFunction
+ I Module FvwmWinList
+ I Module FvwmPager
+ I Exec exec xscreensaver --no-splash --log ~/log/xscreensaver.log
+ I Exec exec xsetbg ~/X11/rainlight.gif
+ I Exec exec urxvt -ls -geometry 100x40+5-5
Test (EnvMatch HOST vdx*) + I Exec /opt/Citrix/VDA/bin/ctxclipboard
Test (EnvMatch HOST jane) + I Exec nice -n 5 xload -jumpscroll 10 -update 2 -geometry 1100x130-2+2
Test (EnvMatch HOST jane) + I Exec LANG=sv_SE.iso88591 exec nice -n 5 dclock -seconds -smallsize 0.8 -miltime -tails -dateup -date '%A %y-%m-%d' -geometry 370x130+1700+2
Test (EnvMatch HOST lx*)  + I Exec nice -n 5 xclock -d -strftime "%A %g-%m-%d %T" -update 1 -geometry -2+2
Test (EnvMatch HOST lx*) + I Exec xterm -name launchwindow -ls -geometry 80x15+2+2 -bg "#dbffd4"
Test (EnvMatch HOST vdx*)  + I Exec nice -n 5 xclock -d -strftime "%A %g-%m-%d %T" -update 1 -geometry -2+2
Test (EnvMatch HOST v10073)  + I Exec nice -n 5 xclock -d -strftime "%A %g-%m-%d %T" -update 1 -geometry -2+2
Test (EnvMatch HOST bean) + I Exec LANG=sv_SE.iso88591 exec nice -n 5 dclock -seconds -smallsize 0.8 -miltime -tails -dateup -date '%A %y-%m-%d' -geometry 467x120-2+2

AddToFunc RestartFunction
+ I Module FvwmPager 0 0
+ I Module FvwmWinList

# Complex functions
AddToFunc Move-or-Raise         "M" Move
+				"C" Raise

AddToFunc Lower-or-Resize	"C" Lower
+	  			"M" Resize

AddToMenu modules	"FvwmModules"   Title
+			"FvwmConsole"   Module  FvwmConsole -terminal urxvt
+                       "RootCursor"    Module  FvwmForm RootCursor
+                       "Identify"      Module  FvwmIdent
+                       "Talk"          Module  FvwmTalk
+			"TaskBar"	Module  FvwmTaskBar
+                       ""              Nop
+                       "Button-Bar"    Module  FvwmButtons
+                       "Pager"         Module  FvwmPager 0 0
+                       "Pager (2 desks)" Module  FvwmPager 0 1
+                       "WinList"       Module  FvwmWinList
+                       ""              Nop
+                       "Banner"        Module  FvwmBanner
+                       "ScrollBar"     Module  FvwmScroll 50 50
+                       "Background"    Module  FvwmBacker
+                       "AutoRaise"     Module  FvwmAuto 200 Raise Nop
+                       "Stop AutoRaise" KillModule FvwmAuto
+                       ""              Nop
+                       "IconBox"       Module  FvwmIconBox
+                       "IconMan"       Module  FvwmIconMan
+                       ""              Nop
+                       "Form - QuitVerify"  Module FvwmForm QuitVerify

# Menus
AddToMenu General	"General"	Title
+                       "Mouse binding off" Mouse 1 W M
+                       "Mouse binding on"  Mouse 1 W M Move-or-Raise
+	  		"ssh OFF"	Exec exec ssh-add -D </dev/null > /dev/null 2>&1
+			"Modules"	Popup modules
Test (EnvMatch HOST jane) + "xbiff"       Exec xon ender "xbiff -geometry 83x70+1603+3"
Test (EnvMatch HOST jane) + "ender xload" Exec xon ender "nice -n 5 xload -xrm '*Page: 0 0 1' -jumpscroll 10 -update 2 -geometry 1100x130-2+2"
+			"Refresh"	Refresh
+                       "Restart"       Restart
+			"Quit X"	Quit

AddToMenu hosts
Test (EnvMatch HOST jane) + "ender"  Exec xon ender 'urxvt -bg "#ffdddd" -fg "#544949" -ls -title ender'
Test (EnvMatch HOST bean) + "ender"  Exec exec urxvt -bg "#ffdddd" -fg "#544949" -title ender -e ssh ender.chrekh.se
Test (EnvMatch HOST jane) + "bean"   Exec xon bean 'urxvt -bg "#e0f0ff" -fg "#202040" -ls -title bean'
Test (EnvMatch HOST jane) + "vm01"   Exec xon vm01 'urxvt -bg "#e9ffcf" -fg "#003000" -ls -title vm01'
Test (EnvMatch HOST jane) + "vm02"   Exec xon vm02 'urxvt -bg "#e9ffcf" -fg "#003000" -ls -title vm02'
Test (EnvMatch HOST jane) + "vm03"   Exec xon vm03 'urxvt -bg "#e9ffcf" -fg "#003000" -ls -title vm03'
Test (EnvMatch HOST jane) + "vm04"   Exec xon vm04 'urxvt -bg "#e9ffcf" -fg "#003000" -ls -title vm04'
Test (EnvMatch HOST jane) + "vm05"   Exec xon vm05 'urxvt -bg "#e9ffcf" -fg "#003000" -ls -title vm05'
Test (EnvMatch HOST jane) + "vm06"   Exec xon vm06 'urxvt -bg "#e9ffcf" -fg "#003000" -ls -title vm06'
Test (EnvMatch HOST jane) + "vm07"   Exec exec urxvt -bg "#e9ffcf" -fg "#003000" -title vm07 -e ssh vm07.chrekh.se
Test (EnvMatch HOST jane) + "vm08"   Exec xon vm08 'urxvt -bg "#e9ffcf" -fg "#003000" -ls -title vm08'
Test (EnvMatch HOST jane) + "Wolverine"   Exec exec urxvt -bg "#ffeaff" -fg "#003000" -title Wolverine -e ssh wolverine.incedo.org
Test (EnvMatch HOST jane) + "Huey"   Exec exec urxvt -bg "#ffeaff" -fg "#003000" -title Huey -e ssh huey.incedo.org
Test (EnvMatch HOST jane) + "Dewey"  Exec exec urxvt -bg "#ffeaff" -fg "#003000" -title Dewey -e ssh dewey.incedo.org
Test (EnvMatch HOST jane) + "Louie"  Exec exec urxvt -bg "#ffeaff" -fg "#003000" -title Louie -e ssh louie.incedo.org

# Some big fonts
# -fndry-fmly-wght-slant-swdth-adstyl-pxlsz-ptsz-resx-resy-spc-avgwdth-rgstry-encdng
# -*-*-medium-r-normal-*-20-*-*-*-*-*-iso8859-*
# -*-lucida sans typewriter-medium-r-*-*-20-*-*-*-m-*-iso8859-1
# -*-lucidatypewriter-medium-r-normal-*-18-*-*-*-*-*-iso8859-*

AddToMenu misc	"Misc"		Title
+		"Hosts"		Popup hosts
+		"Rxvt"		Exec exec urxvt -ls
+               "Rxvt (big)"    Exec exec urxvt -ls -fn '-*-*-medium-r-normal-*-20-*-*-*-*-*-iso8859-*'
+		"Xterm"		Exec exec xterm -ls
+ 		"Emacs"		Exec exec emacs -geometry 110x40 > ${HOME}/log/emacs 2>&1
Test (EnvMatch HOST jane) + "Koms"	Exec exec emacs -f koms-with-wait -geometry 114x49+739-22 > ${HOME}/log/emacs-koms 2>&1
Test (EnvMatch HOST bean) + "Koms"	Exec exec emacs -f koms-with-wait -geometry 109x49+5+10 > ${HOME}/log/emacs-koms 2>&1
Test (EnvMatch HOST jane) + "Gnus"	Exec exec emacs -f gnus -geometry 109x49+7+132 > ${HOME}/log/emacs-gnus 2>&1
Test (EnvMatch HOST bean) + "Gnus"	Exec exec emacs -f gnus -geometry 109x49+5+10 > ${HOME}/log/emacs-gnus 2>&1
Test (EnvMatch HOST jane) + "Chrome"	Exec exec google-chrome-stable  > /${HOME}/log/chrome 2>&1
Test (EnvMatch HOST bean) + "Chrome"	Exec exec google-chrome-stable --start-maximized  > /${HOME}/log/chrome 2>&1
Test (EnvMatch HOST vdx*) + "Chrome"	Exec exec google-chrome-stable --start-maximized  > /${HOME}/log/chrome 2>&1
Test (EnvMatch HOST jane) + "Strawberry"    Exec strawberry > ${HOME}/log/strawberry 2>&1
Test (EnvMatch HOST jane) + "Thunderbird"   Exec thunderbird > ${HOME}/log/thunderbird 2>&1
Test (EnvMatch HOST lx*)  + "UmBasA"	    Exec exec vmware -X /localhome/chrekh/vmware/umbasa/umbasa.vmx > /dev/null 2>&1
Test (EnvMatch HOST lx*)  + "Snake"	    Exec exec rdesktop -k sv -g 1280x1024 snake >/dev/null 2>&1
Test (EnvMatch HOST lx*)  + "Vcum"	    Exec exec rdesktop -k sv -g 1280x1024 vcum >/dev/null 2>&1
Test (EnvMatch HOST jane) + "Mu4e"	    Exec xon ender 'emacs -geometry 105x50+791+269 -f mu4e'&
Test (EnvMatch HOST jane) + "Aumix"	    Exec aumix
Test (EnvMatch HOST jane) + "slack"	    Exec slack
Test (EnvMatch HOST bean) + "slack"	    Exec slack
Test (EnvMatch HOST jane) + "Virtmanager"   Exec virt-manager
Test (EnvMatch HOST jane) + "Xboard -tc 30" Exec xboard -tc 30
Test (EnvMatch HOST jane) + "Xboard -ncp"   Exec xboard -ncp
Test (EnvMatch HOST jane) + "Spotify"	    Exec spotify

AddToMenu winmenu	"Raise"		Raise
+	  		"Move"		Move

+			"Resize"	Resize
+			"Iconify"	Iconify
+			"Delete"	Delete
+			"Close"		Close
+			"Destroy"	Destroy

AddToFunc Raise-or-winmenu 	C 	Raise
+				M	Popup winmenu

AddToFunc MyMove		M	Move

# title-bar and sides
Mouse	1	T	N	Function Move-or-Raise
Mouse	1	T	S	Function Move-or-Raise
Mouse	3	T	N	Lower
Mouse	3	T	S	Lower

Mouse	1	S	N	Function Move-or-Raise
Mouse	3	S	N	Lower

# window
Mouse	1	W	M	Function Move-or-Raise
Mouse	2	WI	M	Popup winmenu
Mouse	3	WI	M	Function Lower-or-Resize

Mouse	1	I	N	Iconify

# root
Mouse	1	R	N	Menu General
Mouse	3	R	N	Menu misc

# The small buttons in the title-bar

Mouse 1		1	A	Menu winmenu
Mouse 1		2	A	Maximize 100 100

# Key bindings
Key	Pause	A	N	exec xscreensaver-command -lock
Key	XF86PowerOff A  N	exec xscreensaver-command -lock
Key	XF86MonBrightnessDown A N exec xbacklight -dec 5
Key	XF86MonBrightnessUp   A N exec xbacklight -inc 5
Key     Tab     A       M

########################## Icon Manager ####################################
*FvwmIconMan*background #ffb090
*FvwmIconMan*foreground Black
*FvwmIconMan*format "%t"
*FvwmIconMan*managergeometry +5+5
*FvwmIconMan*followfocus true
*FvwmIconMan*focusbutton          up Yellow #853f5a
*FvwmIconMan*focusandselectButton down Yellow #853f5a


########################## Window-Identifier ###############################
*FvwmIdentBack MidnightBlue
*FvwmIdentFore Yellow
*FvwmIdentFont -adobe-helvetica-medium-r-*-*-12-*-*-*-*-*-*-*

########################### Pager #########################################
*FvwmPagerBack Black
*FvwmPagerFore Orchid
*FvwmPagerFont -adobe-helvetica-bold-r-*-*-10-*-*-*-*-*-*-*
*FvwmPagerHilight Black
*FvwmPagerGeometry -2-2@0
*FvwmPagerLabel 0 Pager
*FvwmPagerSmallFont 5x8

##########################FvwmWinList##################################
*FvwmWinList: Back #e08020
*FvwmWinList: Fore Black
*FvwmWinList: FocusBack #853f5a
*FvwmWinList: FocusFore yellow
*FvwmWinList: Font -adobe-times-*-r-*-*-17-*-100-100-p-*-iso10646-1
*FvwmWinList: Action Click1 Iconify
*FvwmWinList: Action Click2 Iconify -1, Focus
*FvwmWinList: Action Click3 Iconify -1, Focus
*FvwmWinList: UseSkipList
*FvwmWinList: Geometry -2+145@0
