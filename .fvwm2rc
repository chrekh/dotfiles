Style "*" Font -adobe-times-medium-r-normal-*-14-*-*-*-*-*-*-*

DeskTopSize 1x3

#Style * EdgeMoveDelay 250
#Style * EdgeMoveResistance 2 2

EdgeScroll 100 100

ClickTime 750
ColormapFocus FollowsFocus
OpaqueMoveSize 100

IgnoreModifiers L2

Style "*" ResizeOpaque, HilightFore yellow, HilightBack #853f5a
#MenuStyle * Font lucidasanstypewriter-12
MenuStyle * Font -adobe-courier-*-r-normal-*-14-*-*-*-*-*-iso8859-1

Style * SloppyFocus, BorderWidth 5, !Handles , !Icon, Color black/#e08020
Style * !UsePPosition
Style "FvwmWinList" !Title, Sticky, WindowListSkip, NeverFocus
Style "FvwmIconMan" !Title, Sticky, WindowListSkip, NeverFocus
Style "FvwmPager"   !Title, Sticky, NeverFocus
Style "XDaliClock"  !Title, Sticky, NeverFocus
Style "XClock"      !Title, Sticky, NeverFocus
Style "Xlogin"      !Title, Sticky, PositionPlacement UnderMouse
Style "dclock"      !Title, Sticky
Style "XLoad"	    !Title, Sticky, NeverFocus, !Borders
Style "rdesktop"    !Title, !Borders
Style "xcpustate"   !Title, Sticky, NeverFocus
Style "XBiff"       !Title, Sticky, NeverFocus
Style "XBuffy"      !Title, Sticky, NeverFocus

# What to do at startup
AddToFunc InitFunction
+ I Module FvwmWinList
+ I Module FvwmPager
+ I Exec exec xscreensaver -no-capture-stderr -no-splash
+ I Exec exec xsetbg /localhome/chrekh/img/rainlight.gif
#+ I Exec exec emacs -geometry 115x60-1602-30
+ I Exec exec urxvt -ls -geometry 100x40+5+5
+ I Exec exec xmodmap ${HOME}/X11/xmodmap/sled
+ I Exec LANG=sv_SE.iso88591 exec nice -n 5 dclock -seconds -smallsize 0.8 -miltime -tails -dateup -date '%A %y-%m-%d' -geometry 467x140+1436+3

AddToFunc RestartFunction
+ I Module FvwmPager 0 0
+ I Module FvwmWinList

# Complex functions
AddToFunc Move-or-Raise         "M" Move
+				"C" Raise

AddToFunc Lower-or-Resize	"C" Lower
+	  			"M" Resize

AddToMenu modules	"FvwmModules"   Title
+			"FvwmConsole"   Module  FvwmConsole
+                       "Identify"      Module  FvwmIdent
+                       "Talk"          Module  FvwmTalk
+                       ""              Nop
+                       "Button-Bar"    Module  FvwmButtons
+                       "Pager"         Module  FvwmPager 0 0
+                       "Pager (2 desks)" Module  FvwmPager 0 1
+                       "WinList"       Module  FvwmWinList
+                       ""              Nop
+                       "Banner"        Module  FvwmBanner
+                       "ScrollBar"     Module  FvwmScroll 50 50
+                       "Background"    Module  FvwmBacker
+                       "AutoRaise"     Module  FvwmAuto 200 Raise Nop
+                       "Stop AutoRaise" KillModule FvwmAuto
+                       ""              Nop
+                       "IconBox"       Module  FvwmIconBox
+                       "IconMan"       Module  FvwmIconMan
+                       ""              Nop
+                       "Form - Rlogin"      Module FvwmForm Rlogin
+                       "Form - MyFvwmTalk"  Module FvwmForm MyFvwmTalk
+                       "Form - QuitVerify"  Module FvwmForm QuitVerify

# Menus
AddToMenu General	"General"	Title
+	  		"ssh ON"	Exec exec ssh-add -t 2h </dev/null > /dev/null 2>&1
+	  		"ssh OFF"	Exec exec ssh-add -D </dev/null > /dev/null 2>&1
+			"Modules"	Popup modules
+			"Refresh"	Refresh
+                       "Restart"       Restart
+			"Quit X"	Quit

AddToMenu misc	"Misc"		Title
+		"Xlogin"	Exec exec xlogin.pl
+		"Hosts"		Popup hosts
+		"Rxvt"		Exec exec urxvt -ls
+		"Xterm"		Exec exec xterm -ls
+		"Emacs"		Exec exec emacs > ${HOME}/log/emacs 2>&1
+		"Firefox"	Exec exec firefox -no-remote -P default > /${HOME}/log/firefox 2>&1
+		"UmBasA"	Exec exec vmplayer -X /localhome/chrekh/vmware/umbasa/umbasa.vmx > /dev/null 2>&1
+		"Snake"		Exec exec rdesktop -k sv -g 1280x1024 snake >/dev/null 2>&1

AddToMenu hosts "HP-UX"    popup Host_hpux
+               ""              Nop
+               "EN225500"      popup "Host_en225500"
+               "EN225270"      popup "Host_en225270"
+               "EN225260"      popup "Host_en225260"
+               "EN225320"      popup "Host_en225320"
+               "EN229600"      popup "Host_en229600"
+               ""              Nop
+               "Linux (rack)"  popup "Host_linux_rack"
+               "Linux (virt)"  popup "Host_linux_V"
+               "Labb"          popup "Host_linux_Labb"


AddToMenu Host_hpux
PipeRead 'fvwmhostmenu.pl hpux'
        
AddToMenu Host_en225500
PipeRead 'fvwmhostmenu.pl EN225500'

AddToMenu Host_en225270
PipeRead 'fvwmhostmenu.pl EN225270'

AddToMenu Host_en225260
PipeRead 'fvwmhostmenu.pl EN225260'

AddToMenu Host_en225320
PipeRead 'fvwmhostmenu.pl EN225320'

AddToMenu Host_en229600
PipeRead 'fvwmhostmenu.pl EN229600'

AddToMenu Host_linux_rack
PipeRead 'fvwmhostmenu.pl rackservrar'

AddToMenu Host_linux_V
PipeRead 'fvwmhostmenu.pl virtuella'

AddToMenu Host_linux_Labb
PipeRead 'fvwmhostmenu.pl labb'

AddToMenu winmenu	"Raise"		Raise
+	  		"Move"		Move
+			"Resize"	Resize
+			"Iconify"	Iconify
+			"Delete"	Delete
+			"Close"		Close
+			"Destroy"	Destroy

			
AddToFunc Raise-or-winmenu 	C 	Raise
+				M	Popup winmenu

# Mouse bindings
# Mouse Button Context Modifiers Function
# Context:   T=title, R=root, W=window S=side F=frame I=icon
# Modifiers: N=no, C=controll, S=shift, M=meta, L=Caps-Lock, A=any 

# title-bar and sides
Mouse	1	T	N	Function Move-or-Raise
Mouse	1	T	S	Function Move-or-Raise
Mouse	3	T	N	Lower
Mouse	3	T	S	Lower

Mouse	1	S	N	Function Move-or-Raise
Mouse	3	S	N	Lower

# window
Mouse	1	W	M	Function Move-or-Raise
Mouse	2	WI	M	Popup winmenu
Mouse	3	WI	M	Function Lower-or-Resize

Mouse	1	I	N	Iconify

# root
Mouse	1	R	A	Menu General
Mouse	3	R	A	Menu misc


# The small buttons in the title-bar

Mouse 1         1       A       Menu winmenu
Mouse 1		2	A	Maximize 100 100
Mouse 1		3	A	Iconify

# Key bindings
Key	Pause	A	N	exec xscreensaver-command -lock
#Key	Pause	A	N	exec xdotool mousemove 500 500

########################## Icon Manager ####################################
*FvwmIconMan*background #ffb090
*FvwmIconMan*foreground Black
*FvwmIconMan*format "%t"
*FvwmIconMan*managergeometry +5+5
*FvwmIconMan*followfocus true
*FvwmIconMan*focusbutton          up Yellow #853f5a
*FvwmIconMan*focusandselectButton down Yellow #853f5a


########################## Window-Identifier ###############################
*FvwmIdentBack MidnightBlue
*FvwmIdentFore Yellow
*FvwmIdentFont -adobe-helvetica-medium-r-*-*-12-*-*-*-*-*-*-*

########################### Pager #########################################
*FvwmPagerBack Black
*FvwmPagerFore Orchid
*FvwmPagerFont -adobe-helvetica-bold-r-*-*-10-*-*-*-*-*-*-*
*FvwmPagerHilight Black
*FvwmPagerGeometry -2-2@0
*FvwmPagerLabel 0 Pager
*FvwmPagerSmallFont 5x8

##########################FvwmWinList##################################
*FvwmWinList: Back #e08020
*FvwmWinList: Fore Black
*FvwmWinList: FocusBack #853f5a
*FvwmWinList: FocusFore yellow
*FvwmWinList: Font -adobe-helvetica-bold-r-*-*-10-*-*-*-*-*-*-*
*FvwmWinList: Action Click1 Iconify
*FvwmWinList: Action Click2 Iconify -1, Focus
*FvwmWinList: Action Click3 Iconify -1, Focus
*FvwmWinList: UseSkipList
*FvwmWinList: Geometry -2+280
