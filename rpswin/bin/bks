#! /bin/bash

declare -a hosts
for arg in "$@"; do
    case $arg in
	--sync)
	    sync=1
	    ;;
	--run=*)
	    runcmd=${arg##--run=}
	    ;;
	-*)
	    echo "invalid argument $arg" >&2
	    exit 1
	    ;;
	*)
	    hosts+=("$arg")
	    ;;
    esac
done
echo "${hosts[@]}"

syncdbfile=~/db/hostsync
if [[ -r $syncdbfile ]]; then
    . $syncdbfile
else
    declare -A syncdb
fi

for h in "${hosts[@]}"; do
    host="$h"
    for dom in '' .polisen.se .dc.polisen.se .pki.polisen.se .mgmt.polisen.se .bd.polisen.se; do
        # Use ping to find domain
        fqdn=$(ping -n 1 "${h}$dom" 2>/dev/null | awk '/^Pinging/{print $2}')
        if [[ $fqdn ]]; then
	    host="$fqdn"
	    break
	fi
    done

    user=u0043002

    if [[ $runcmd ]]; then
	echo "${host}"
	blink "${user}@${host}" "$runcmd"
	continue;
    fi
    if [[ ! ${syncdb["${host}"]} ]]; then
	sync=1
    fi
    if [[ $sync ]]; then
	set -x
	blink "${user}@${host}" date
	tar --create --file=- --directory="${HOME}" --no-recursion \
	  --files-from="${HOME}/db/dotfiles" \
	  | blink "${user}@${host}" tar xf -
	set +x
	syncdb["${host}"]=$(date +%s)
	synced=1
    fi

    if [[ ${synced} ]]; then
	declare -p syncdb > $syncdbfile
    fi
    echo bokssh "${user}@${host}"
    nohup bokssh "${user}@${host}" > /dev/null 2>&1 &
done
