#! /bin/bash

case $1 in
    --sync)
	sync=1
	shift
	;;
esac

for h in "$@"; do
    for dom in '' .dc.polisen.se .pki.polisen.se .polisen.se; do
        # Use ping to find domain
        fqdn=$(ping -n 1 git 2>/dev/null | awk '/^Pinging/{print $2}')
        host=${h}${dom}
        [[ -z $fqdn ]] || break
    done

    user=u0043002

    if [[ $sync ]]; then
	set -x
	tar --create --file=- --directory="${HOME}" --no-recursion \
	  --files-from="${HOME}/db/dotfiles" \
	  | blink "${user}@${host}" tar xf -
	set +x
    fi

    echo bokssh "${user}@${host}"
    nohup bokssh "${user}@${host}" > /dev/null 2>&1 &
done
