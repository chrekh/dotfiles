#! /bin/bash

case $1 in
    --sync)
	sync=1
	shift
	;;
esac

for h in "$@"; do
    for dom in '' .dc.polisen.se .pki.polisen.se .polisen.se; do
        # Use nslookup to find domain
        fqdn=$(nslookup "${h}${dom}" 2>/dev/null | awk '/Name:/{print $NF}')
        host=${h}${dom}
        [[ -z $fqdn ]] || break
    done

    user=u0043002

    if [[ $sync ]]; then
	tar --create --file=- --directory="${HOME}" --no-recursion --files-from="${HOME}/db/dotfiles" | blink "${user}@${host}" tar xf -
    fi

    echo bokssh "${user}@${host}"
    nohup bokssh "${user}@${host}" > /dev/null 2>&1 &
done
