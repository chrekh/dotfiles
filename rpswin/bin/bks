#! /bin/bash

declare -a hosts
for arg in "$@"; do
    case $arg in
	--sync)
	    sync=1
	    ;;
	--run=*)
	    runcmd=${arg##--run=}
	    ;;
	-*)
	    echo "invalid argument $arg" >&2
	    exit 1
	    ;;
	*)
	    hosts+=("$arg")
	    ;;
    esac
done
echo "${hosts[@]}"

syncdbfile=~/db/hostsync
if [[ -r $syncdbfile ]]; then
    . $syncdbfile
else
    declare -A syncdb
fi

# Restart netid if not done within the last 10 minutes
if [[ $(( $(stat --format %Y ~/tmp/netid) + 600 )) < $(date +%s) ]]; then
  echo Restart netid
  "C:\Program Files\Net iD\iid.exe" -restart
  touch ~/tmp/netid
  sleep 1
fi

for h in "${hosts[@]}"; do
    host="$h"
    for dom in '' .polisen.se .dc.polisen.se .pki.polisen.se .mgmt.polisen.se .bd.polisen.se; do
        # Use ping to find domain
        fqdn=$(ping -n 1 "${h}$dom" 2>/dev/null | awk '/^Pinging/{print $2}')
        if [[ $fqdn ]]; then
	    host="$fqdn"
            domain=${fqdn##"${h}."}
	fi
    done

    if [[ $domain == 'pki.polisen.se' ]]; then
      session=Boks
      user=a0043002
    else
      session=Linux
      user=u0043002
    fi

    if [[ $runcmd ]]; then
	echo "*** ${host}"
	blink "${user}@${host}" "$runcmd"
	continue;
    fi
    if [[ ! ${syncdb["${host}"]} ]]; then
	sync=1
    fi
    if [[ $sync ]]; then
	set -x
	blink "${user}@${host}" date
	tar --create --file=- --directory="${HOME}" --no-recursion \
	  --files-from="${HOME}/db/dotfiles" \
	  | blink -load "$session" "${user}@${host}" tar xf -
	set +x
	syncdb["${host}"]=$(date +%s)
	synced=1
    fi

    if [[ ${synced} ]]; then
	declare -p syncdb > $syncdbfile
    fi
    echo bokssh -load "$session" "${user}@${host}"
    nohup bokssh -load "$session" "${user}@${host}" > /dev/null 2>&1 &
done
