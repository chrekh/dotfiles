if [ x$host = 'xender' ]; then
    spam() {
	for f in $@; do
            echo -n "$f "
            mv $f $f.spamtmp
            sa-learn --spam --mbox $f.spamtmp
            rm -f $f.spamtmp
	done
    }
fi

setpath() {
    local -A used
    local newpath
    for d in $@; do
	[ -n "${used[$d]}" ] && continue
	used[$d]=y
	[ -d $d ] || continue
	if [ -z "$newpath" ]; then
	    newpath=$d
	else
	    newpath=$newpath:$d
	fi
    done
    echo $newpath
}
