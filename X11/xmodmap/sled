!! Default modifier-map
!mod1        Alt_L (0x40),  Meta_L (0x9c)
!mod2        Num_Lock (0x4d)
!mod3      
!mod4        Super_L (0x73),  Super_R (0x74),  Super_L (0x7f),  Hyper_L (0x80)
!mod5        Mode_switch (0x8),  ISO_Level3_Shift (0x71),  ISO_Level3_Shift (0x7c)

clear lock

!clear mod1
!clear mod2
!clear mod3
!clear mod4
clear mod5

! Alt (Alt_L) (keycode 64)
!add mod3 = Alt_L

! Meta (win-button) (Super_L) (keycode 115)
!add mod2 = Alt_L

! AltGr
keycode 113 = Mode_switch
add mod5 = Mode_switch

! {|}  дце
keycode 48 = braceleft bracketleft adiaeresis Adiaeresis
keycode 47 = bar backslash odiaeresis Odiaeresis
keycode 34 = braceright bracketright aring Aring

! ~^ь№
keycode 35 = asciitilde asciicircum udiaeresis Udiaeresis
! `@й…
keycode 21 = grave at eacute Eacute
keycode 13 = 4 dollar

! Numeric Keypad
keycode 90 = 0
keycode 87 = 1
keycode 88 = 2
keycode 89 = 3
keycode 83 = 4
keycode 84 = 5
keycode 85 = 6
keycode 79 = 7
keycode 80 = 8
keycode 81 = 9
