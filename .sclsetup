# -*- mode: shell-script -*-

# shellcheck shell=bash
# shellcheck source=./.functions

if [[ $dist == RedHat ]] && hash scl > /dev/null 2>&1; then
  # Setup Software Collection environment
  if [[ $rel_maj -gt 7 ]]; then
    listopt=list-collections
  else
    listopt=--list
  fi

  # Find the "best" git, and use that
  git=$(scl $listopt | grep ^rh-git | sort -V | tail -n 1)
  [[ -r "/opt/rh/$git/enable" ]] && source "/opt/rh/$git/enable"
fi

# shellcheck disable=SC2034
sclsetup=y
