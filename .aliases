# -*- mode: shell-script -*-

alias ls='ls -F'
alias ll='ls -al'
if [ $os = Li ]; then
    alias df='df -h'
    alias ls='ls -vF'
    alias ll='ls -halv --time-style="+%y-%m-%d %H:%M:%S"'
    if free -V | grep -q procps-ng; then
	alias free='free -ht'
    else
	alias free='free -mt'
    fi
elif [ $os = Da ]; then
    alias df='df -h'
elif [ $os = HP ]; then
    alias df=bdf
fi

alias rootxauth='sudo -H xauth add `xauth list $DISPLAY`'
alias g=git
alias l=less
alias zl=zless
alias llt='ll -tr'
alias j=jobs
alias f='finger -m'
alias h='history'
alias gzip='gzip --best'

#Run mac-emacs on mac OS X
if [ "${TERM_PROGRAM}" = "iTerm.app" ]; then
    alias emacs='/Applications/Emacs.app/Contents/MacOS/Emacs $@'
fi

# Btrfs
if [ -x /sbin/btrfs ]; then
    alias b='sudo btrfs'
fi

# BoKS
if [ -x /opt/boksm/bin/suexec ]; then
    alias sudo=/opt/boksm/bin/suexec
    alias sbash="suexec bash --rcfile $(echo ~/.bashrc)"
fi

# COW (Copy-On-Write) if supported
if [ $os = Li ]; then
    (( ${cu_ver[0]} > 7 && ${cu_ver[1]} > 6 )) && alias cp='cp --reflink=auto'
fi

[ $DISPLAY ] || alias x='xstart'

if [ -x /usr/local/bin/morse ]; then
    alias morse='time /usr/local/bin/morse -r -C 'qwertyuiopasdfghjklzxcvbnm,.?/}{\\\|' -w 20 -T -q -n 5 -N 100'
fi

# Gentoo
if [ $dist = Gentoo ]; then
    alias qpkg='qpkg -nc'
    alias equery='equery --nocolor'
    alias genlop='genlop --nocolor'
    alias eix='eix -n'
    worldopts='--deep --update --ask --verbose y --keep-going --newuse --with-bdeps y --verbose-conflicts --backtrack=8'
    if [ $host = jane ]; then
	worldopts="$worldopts --jobs=5 --load-average=10"
    elif [ $host = ender ]; then
	worldopts="$worldopts --jobs=2 --load-average=4"
    fi
    alias world="sudo emerge $worldopts @system @world"
fi

# RPS
if [ "$domain" = utv.rps.police.se ]; then
    alias nds='ldapsearch -x -h fs-rpsutv-1 -b ou=rps,o=police,c=se -D CN=u0043002,OU=USE,OU=RPS,O=POLICE,C=SE -y /localhome/chrekh/ldappw'
    alias ads='net ads -U a0043002@UMAD.UTV.POLISEN.SE search'
fi
if [ "$domain" = utv.polisen.se ]; then
    if rpm -q rxvt-unicode > /dev/null 2>&1; then
	alias rxvt="urxvt -ls -bg '#ffd0c0' -fg '#000000'"
    else
	alias rxvt="xterm -ls -bg '#ffd0c0' -fg '#000000'"
    fi
fi
if pum < /dev/null > /dev/null 2>&1; then
    alias last='last -F|egrep -v ^cmdb|tac|pum'
fi

# ClearCase
if type cleartool > /dev/null 2>&1; then
    alias c=cleartool
    alias sc='sudo cleartool'
fi
