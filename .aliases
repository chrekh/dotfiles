# -*- mode: shell-script -*-

if [ $os = Li ]; then
    alias df='df -h'
    alias ls='ls -vF'
    alias ll='ls -halv --time-style="+%y-%m-%d %H:%M:%S"'
elif [ $os = Da ]; then
    alias df='df -h'
else
    alias ls='ls -F'
    alias ll='ls -al'
fi

alias g=git
alias l=less
alias zl=zless
alias llt='ll -tr'
alias j=jobs
alias f='finger -m'
alias h='history'

# BoKS
if [ -x /opt/boksm/bin/suexec ]; then
    alias sudo=/opt/boksm/bin/suexec
fi

# COW (Copy-On-Write) if supported
if [ $os = Li ]; then
    (( ${cu_ver[0]} > 7 && ${cu_ver[1]} > 6 )) && alias cp='cp --reflink=auto'
fi

[ $DISPLAY ] || alias x=xstart

if [ -x /usr/local/bin/morse ]; then
    alias morse='time /usr/local/bin/morse -r -C 'qwertyuiopasdfghjklzxcvbnm,.?/}{\\\|' -w 20 -T -q -n 5 -N 100'
fi

# Gentoo
if [ $dist = gentoo ]; then
    alias qpkg='qpkg -nc'
    alias equery='equery --nocolor'
    alias genlop='genlop --nocolor'
    alias eix='eix -n'
    worldopts='--deep --update --ask --verbose y --keep-going --newuse --with-bdeps y'
    if [ $host = jane ]; then
	worldopts="$worldopts --jobs=10 --load-average=30"
    fi
    alias world="sudo emerge $worldopts @system @world"
fi

# RPS
if [ "$domain" = utv.rps.police.se ]; then
    alias nds='ldapsearch -x -h fs-rpsutv-1 -b ou=rps,o=police,c=se -D CN=u0043002,OU=USE,OU=RPS,O=POLICE,C=SE -y /localhome/chrekh/ldappw'
fi
if [ "$domain" = utv.polisen.se ]; then
    if rpm -q rxvt-unicode > /dev/null 2>&1; then
	alias rxvt="urxvt -ls -bg '#ffd0c0' -fg '#000000'"
    else
	alias rxvt="xterm -ls -bg '#ffd0c0' -fg '#000000'"
    fi
fi

# ClearCase
if type cleartool > /dev/null 2>&1; then
    alias c=cleartool
    alias sc='sudo cleartool'
fi
