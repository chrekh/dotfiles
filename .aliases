# -*- mode: shell-script -*-

if [ $os = Li ]; then
    alias df='df -h'
    alias ls='ls -vF'
    alias ll='ls -halv --time-style="+%y-%m-%d %H:%M:%S"'
else
    alias ls='ls -F'
    alias ll='ls -al'
fi
alias l=less
alias zl=zless
alias llt='ll -tr'
alias j=jobs
alias f='finger -m'
alias h='history'

# COW (Copy-On-Write) on btrfs
[ x$os = xLi ] && alias cp='cp --reflink=auto'

[ x$DISPLAY = x ] && alias x=xstart

if [ -x /usr/local/bin/morse ]; then
    alias morse='time /usr/local/bin/morse -r -C 'qwertyuiopasdfghjklzxcvbnm,.?/}{\\\|' -w 20 -T -q -n 5 -N 100'
fi

# Gentoo
if [ x$dist = xgentoo ]; then
    alias qpkg='qpkg -nc'
    alias equery='equery --nocolor'
    alias genlop='genlop --nocolor'
    alias eix='eix -n'
    if [ x$host = 'xjane' ]; then
	alias world='sudo emerge -Duav --keep-going --jobs=10 --load-average=30 \
                     --reinstall changed-use --with-bdeps y @system @world'
    fi
    if [ x$host = 'xender' ]; then
	alias world='sudo emerge -Duav --keep-going \
                     --reinstall changed-use --with-bdeps y @system @world'
    fi
fi

# RPS
if [ x$domain = xutv.rps.police.se ]; then
    alias nds='ldapsearch -x -h fs-rpsutv-1 -b ou=rps,o=police,c=se -D CN=chrekh,OU=USE,OU=RPS,O=POLICE,C=SE -y /localhome/chrekh/ldappw'
fi

# ClearCase
if type cleartool > /dev/null 2>&1; then
    alias c=cleartool
    alias sc='sudo cleartool'
fi
