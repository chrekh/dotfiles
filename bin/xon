#! /bin/bash

remote=$1;
shift;

case $DISPLAY in
    :0*)
	disp=$(hostname).chrekh.se"${DISPLAY}"
	;;
    *)
	disp=$DISPLAY
	;;
esac	

# Put xauth information to remote. Send it on stdin so that the cookie
# isn't visible in the process list on the remote.
kaka=$(xauth list "${DISPLAY}"|awk '{print $NF}')
echo "add ${disp} . ${kaka}" | ssh "${remote}" xauth source -

# execute command remote
ssh -T -f -o 'ForwardX11 no' -o 'ForwardX11Trusted no' -o 'ForwardAgent no' \
    "${remote}" "export DISPLAY=$disp;$*>/tmp/xon.log 2>&1 &"
